# ─────────────────────────────────────────────────────────────────────────
# Vercel environment variables for the Vertofi frontends.
# Add these in each Vercel Project → Settings → Environment Variables.
# Only NEXT_PUBLIC_* values are needed (build-time public). Never put server
# secrets here — the browser bundles them.
#
# One Vercel Project per app (set Root Directory to the app folder):
#   apps/web-landing   → vertofi.com
#   apps/web-business  → app.vertofi.com
#   apps/web-panels    → panels.vertofi.com
#   apps/web-admin     → admin.vertofi.com  (keep private / access-protected)
# ─────────────────────────────────────────────────────────────────────────

# Gateway base URL (the GKE api-gateway you deployed). Used by all apps.
NEXT_PUBLIC_API_URL=https://api.vertofi.com/api/v1

# Cross-app links (landing → business/panels)
NEXT_PUBLIC_BUSINESS_URL=https://app.vertofi.com
NEXT_PUBLIC_PANEL_BASE=https://panels.vertofi.com

# Admin only (optional): embed live Grafana
NEXT_PUBLIC_GRAFANA_URL=
