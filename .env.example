# ──────────────────────────────────────────────────────────────
# Vertofi — local environment template. Copy to .env and fill in.
# NEVER commit .env. In production, real secrets live in GCP Secret Manager
# (injected into pods by the External Secrets Operator).
# See setup-guide/02-GCP-COMPLETE-SETUP.md for the production values.
# ──────────────────────────────────────────────────────────────

NODE_ENV=development

# Postgres (local docker; Cloud SQL for PostgreSQL in prod)
DATABASE_URL=postgresql://vertofi:vertofi@localhost:5432/vertofi
DB_SSL=false

# Redis (local docker; Memorystore in prod)
REDIS_URL=redis://localhost:6379

# Kafka — Redpanda locally (plain TCP); Confluent Cloud in prod.
# For Confluent Cloud set the SASL block below; leave it blank for local dev.
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=vertofi
# KAFKA_SSL=true
# KAFKA_SASL_MECHANISM=plain          # plain | scram-sha-256 | scram-sha-512
# KAFKA_SASL_USERNAME=                # Confluent cluster API key
# KAFKA_SASL_PASSWORD=                # Confluent cluster API secret

# Object storage — MinIO locally; Google Cloud Storage (S3-compatible) in prod.
# Prod values:
#   S3_ENDPOINT=https://storage.googleapis.com
#   S3_FORCE_PATH_STYLE=true
#   S3_ACCESS_KEY / S3_SECRET_KEY = GCS HMAC key id + secret
#   (create via: gcloud storage hmac create <SA-email>)
S3_ENDPOINT=http://localhost:9000
S3_REGION=asia-south1
S3_BUCKET=vertofi-documents
S3_ACCESS_KEY=vertofi
S3_SECRET_KEY=vertofi-secret
S3_FORCE_PATH_STYLE=true

# OpenSearch
OPENSEARCH_URL=http://localhost:9200

# Auth / JWT
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900            # 15 min (seconds)
JWT_REFRESH_TTL=2592000       # 30 days (seconds)

# Service ports
GATEWAY_PORT=4000
AUTH_PORT=4001
TENANT_PORT=4002
ACCESS_PORT=4003
AUDIT_PORT=4004
ONBOARDING_PORT=4005
DOCUMENT_PORT=4006
BILLING_PORT=4007
OCR_PORT=4008
NOTIFICATION_PORT=4009
AI_GATEWAY_PORT=4010
LEDGER_PORT=4011
CATEGORIZATION_PORT=4012
RECONCILIATION_PORT=4013
EXCEPTION_PORT=4014
BANK_CONNECTOR_PORT=4015
GST_CONNECTOR_PORT=4016
ACCOUNTING_SYNC_PORT=4017
WHATSAPP_PORT=4018
BHS_PORT=4019
REPORTING_PORT=4020
PREDICTION_PORT=4021
LIFEGUARD_PORT=4022
VENDOR_PORT=4023
VBD_PORT=4024
LEGAL_PORT=4025
BHS_INTEL_PORT=4026
BENCHMARKS_PORT=4027
WARRANTY_PORT=4028
VERIFICATION_PORT=4029
ADMIN_CONSOLE_PORT=4030
AI_GATEWAY_URL=http://localhost:4010

# Gateway CORS allowlist (frontend origins). Prevents CORS errors in dev & prod.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Admin console (internal portal) extras
NEXT_PUBLIC_GRAFANA_URL=        # embed live Grafana dashboards in the Observability tab
AI_USD_PER_1K_TOKENS=0.0006     # rate for the (real metered-token) AI cost estimate
GITHUB_TOKEN=                   # show GitHub Actions runs in the Pipelines tab
GITHUB_REPO=                    # e.g. your-org/vertofi
APP_FIELD_KEY=                  # pgcrypto symmetric key for at-rest field encryption (from vault)

# Frontend → gateway base URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Frontend dev ports: landing 3000 · business 3001 · panels 3002 · admin 3003
# Public landing links only to business (3001) + panels (3002). The internal
# admin portal (apps/web-admin, port 3003) is NOT referenced by the public site
# and in production is served on an internal-only domain (VPN / IP allowlist).
# See docs/23-internal-admin-isolation.md
NEXT_PUBLIC_BUSINESS_URL=http://localhost:3001
NEXT_PUBLIC_PANEL_BASE=http://localhost:3002

# ── Break-glass OTP (DEV / pilot only — NEVER a hardcoded code) ──
# Lets you log in when SMTP/SMS aren't configured. Requires BOTH:
OTP_BYPASS_ENABLED=0          # 1=enable, 0=disable (default off)
OTP_BYPASS_CODE=              # 6-digit operator secret; entered in the OTP box

# ── External connectors (leave blank → connector reports NEEDS_CREDENTIALS,
#    UI shows empty/onboarding state; never fake data) ──
OPENAI_API_KEY=sk-proj-your-openai-key-here
GEMINI_API_KEY=              # optional secondary LLM

# SMS OTP via MSG91 (India / TRAI-DLT). Blank → connector reports NEEDS_CREDENTIALS.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Transactional Email via Resend (Recommended)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Vertofi Verification <noreply@vertofi.com>

# Email OTP via SMTP (SendGrid / Mailgun / Brevo / Google Workspace / SES-SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@vertofi.example

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Subscription plan IDs (create one Plan per tier in the Razorpay dashboard,
# then paste the plan_id here). Required for trial + autopay subscriptions.
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_PRO=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=          # Meta app secret — verifies inbound webhook x-hub-signature-256
GST_GSP_BASE_URL=
GST_GSP_CLIENT_ID=
GST_GSP_CLIENT_SECRET=
AA_BASE_URL=
AA_CLIENT_ID=
AA_CLIENT_SECRET=
# OCR — Google Cloud Vision (recommended on GCP). Blank → docs routed to review.
GOOGLE_VISION_KEY=

# GCP project context (admin console cloud-health + billing tabs).
# On GKE these are provided by Workload Identity; set explicitly elsewhere.
GOOGLE_CLOUD_PROJECT=
GCP_REGION=asia-south1
GCP_BILLING_ACCOUNT_ID=

# Accounting sync targets (accounting-sync service)
TALLY_CONNECTOR_URL=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Verification connectors (payroll / credit bureau / MCA)
PAYROLL_API_KEY=
CREDIT_BUREAU_API_KEY=
MCA_API_KEY=

# Optional read-replica DSN for reporting/admin reads (load balancing)
DATABASE_URL_RO=

ACCOUNTING_PORT=4031
