# ─────────────────────────────────────────────────────────────────────────
# Vertofi — PRODUCTION environment template (GCP).
#
# DO NOT put real secrets in this file. This documents every variable the
# platform reads in production. Real values live in GCP Secret Manager as
# `vertofi-shared-<KEY>` and are projected into every pod by the External
# Secrets Operator (one shared set for all services).
#
# To push a value:
#   printf '%s' 'VALUE' | gcloud secrets versions add vertofi-shared-KEY --data-file=- --project vertofi-prod-001
#   # first time only: gcloud secrets create vertofi-shared-KEY --replication-policy=automatic --project vertofi-prod-001
# Then force a sync + rollout (see docs/ENVIRONMENT_SETUP.md).
#
# Status legend (live as of 2026-06-06): [SET]=configured  [PLACEHOLDER]=needs real value  [MISSING]=not created yet
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Core infrastructure (REQUIRED — platform will not serve without these) ──
DATABASE_URL=postgresql://USER:PASS@CLOUDSQL_HOST:5432/vertofi   # [SET] Cloud SQL Postgres 16
DB_SSL=true                                                       # [SET]
REDIS_URL=redis://MEMORYSTORE_HOST:6379                           # [SET] Memorystore
KAFKA_BROKERS=BOOTSTRAP.confluent.cloud:9092                      # [SET] Confluent Cloud
KAFKA_CLIENT_ID=vertofi                                           # [SET]
KAFKA_SSL=true                                                    # Confluent
KAFKA_SASL_MECHANISM=plain                                        # plain | scram-sha-256 | scram-sha-512
KAFKA_SASL_USERNAME=                                              # Confluent API key
KAFKA_SASL_PASSWORD=                                              # Confluent API secret
S3_ENDPOINT=https://storage.googleapis.com                       # [SET] GCS S3-compatible
S3_FORCE_PATH_STYLE=true                                          # [SET]
S3_REGION=asia-south1                                             # [SET]
S3_BUCKET=                                                        # [SET] documents bucket
S3_ACCESS_KEY=                                                    # [SET] GCS HMAC key id
S3_SECRET_KEY=                                                    # [SET] GCS HMAC secret
APP_FIELD_KEY=                                                    # [SET] pgcrypto field-encryption key

# ── Auth / JWT (REQUIRED — services fail-fast in prod if missing/short) ──
JWT_ACCESS_SECRET=                # [SET] >=16 chars, unique
JWT_REFRESH_SECRET=               # [SET] >=16 chars, unique
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ── Break-glass OTP (TEMPORARY — remove once SMTP/SMS is live) ──
# Lets the pilot team log in while email/SMS delivery is unconfigured.
# Set OTP_BYPASS_ENABLED=0 (or delete both) the moment SMTP_USER/SMTP_PASS are real.
OTP_BYPASS_ENABLED=1              # [SET] 1=on, 0=off
OTP_BYPASS_CODE=                  # [SET] 6-digit operator secret (in Secret Manager only)

# ── Gateway ──
CORS_ORIGINS=https://app.vertofi.com,https://admin.vertofi.com,https://vertofi.com   # [SET]
RATE_LIMIT_PER_MIN=600            # [SET]

# ── EMAIL (Batch 1: Google Workspace SMTP) ──
SMTP_HOST=smtp.gmail.com          # [SET]
SMTP_PORT=587                     # [SET]
SMTP_USER=                        # [PLACEHOLDER] Workspace mailbox (e.g. no-reply@vertofi.com)
SMTP_PASS=                        # [PLACEHOLDER] 16-char Google app password
SMTP_FROM=no-reply@vertofi.com    # [SET]

# ── SMS (Batch 6: MSG91 / TRAI-DLT) ──
MSG91_AUTH_KEY=                   # [PLACEHOLDER]
MSG91_SENDER_ID=VERTFI            # [SET]
MSG91_TEMPLATE_ID=                # [PLACEHOLDER] base DLT template
# Optional per-purpose DLT templates (fallback to MSG91_TEMPLATE_ID):
# MSG91_TEMPLATE_ID_LOGIN= / _REGISTER= / _RESET= / _FINANCIAL= / _DOCUMENT= / _MFA=

# ── WhatsApp (Batch 2: Meta WhatsApp Business) ──
WHATSAPP_API_TOKEN=               # [MISSING]
WHATSAPP_PHONE_ID=                # [MISSING]
WHATSAPP_VERIFY_TOKEN=            # [MISSING] you choose this; paste same value in Meta webhook config
WHATSAPP_APP_SECRET=              # [MISSING] for x-hub-signature-256 verification

# ── Payments (Batch 5: Razorpay) ──
RAZORPAY_KEY_ID=                  # [MISSING]
RAZORPAY_KEY_SECRET=              # [MISSING]
RAZORPAY_WEBHOOK_SECRET=          # [MISSING]
RAZORPAY_PLAN_STARTER=            # [MISSING] plan_id
RAZORPAY_PLAN_GROWTH=             # [MISSING] plan_id
RAZORPAY_PLAN_PRO=                # [MISSING] plan_id

# ── GST (Batch 3: Masters India / GSP) ──
GST_GSP_BASE_URL=                 # [MISSING]
GST_GSP_CLIENT_ID=                # [MISSING]
GST_GSP_CLIENT_SECRET=            # [MISSING]

# ── Banking (Batch 4: Setu Account Aggregator) ──
AA_BASE_URL=                      # [MISSING]
AA_CLIENT_ID=                     # [MISSING]
AA_CLIENT_SECRET=                 # [MISSING]

# ── Intelligence (AI) ──
OPENAI_API_KEY=                   # [MISSING] primary LLM
GEMINI_API_KEY=                   # [MISSING] optional secondary LLM

# ── OCR ──
GOOGLE_VISION_KEY=                # [MISSING] Cloud Vision API key (or use Workload Identity)

# ── Accounting sync targets (optional) ──
TALLY_CONNECTOR_URL=              # [MISSING]
ZOHO_CLIENT_ID=                   # [MISSING]
ZOHO_CLIENT_SECRET=               # [MISSING]
QBO_CLIENT_ID=                    # [MISSING]
QBO_CLIENT_SECRET=                # [MISSING]

# ── Verification connectors (optional) ──
PAYROLL_API_KEY=                  # [MISSING]
CREDIT_BUREAU_API_KEY=            # [MISSING]
MCA_API_KEY=                      # [MISSING]

# ── GCP context (admin console cloud tabs; provided by Workload Identity on GKE) ──
GOOGLE_CLOUD_PROJECT=vertofi-prod-001
GCP_REGION=asia-south1
GCP_BILLING_ACCOUNT_ID=

# ── Frontend (set in Vercel project env, NOT here) ──
# NEXT_PUBLIC_API_URL=https://api.vertofi.com/api/v1
