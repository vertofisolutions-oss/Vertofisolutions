# Production image for a Next.js app in the monorepo.
# Build with: docker build -f infra/docker/Dockerfile.next --build-arg APP=web-landing -t vertofi/web-landing .
ARG NODE_VERSION=22
FROM node:${NODE_VERSION}-slim AS base
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* .npmrc tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile=false

FROM deps AS build
ARG APP
# Remove stale build outputs so Next.js always builds fresh
RUN find /repo/apps -name ".next" -type d -exec rm -rf {} + 2>/dev/null || true
RUN find /repo/packages -name "dist" -type d -exec rm -rf {} + 2>/dev/null || true
RUN pnpm --filter "@vertofi/${APP}" build

FROM base AS runtime
ARG APP
ENV NODE_ENV=production \
    COREPACK_HOME=/tmp/corepack \
    HOME=/tmp \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=build /repo /repo
WORKDIR /repo/apps/${APP}
EXPOSE 3000
CMD ["node", "node_modules/.bin/next", "start"]
